{
  "name": "shastra-backend",
  "version": "1.0.0",
  "description": "Shastra — Vivekananda Education Platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "roots": ["<rootDir>", "<rootDir>/../tests"],
    "testMatch": ["**/*.test.js"],
    "modulePaths": ["<rootDir>/node_modules"]
  },
  "keywords": ["education", "vivekananda", "hackathon", "shastra"],
  "license": "MIT"
}
